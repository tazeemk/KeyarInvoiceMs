{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://keyar-invoice-api.onrender.com/api/"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://keyar-invoice-api.onrender.com/api/"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
