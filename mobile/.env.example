# Android emulator to a backend published on the host machine:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/

# Physical-device testing: replace with the computer's LAN IP, for example
# EXPO_PUBLIC_API_URL=http://192.168.1.25:8000/api/

# Production: use the public HTTPS API origin:
# EXPO_PUBLIC_API_URL=https://invoices.example.com/api/
