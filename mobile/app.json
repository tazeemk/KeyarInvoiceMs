{
  "expo": {
    "name": "Keyar Invoices",
    "slug": "keyar-invoices",
    "scheme": "keyarinvoices",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/keyar-app-icon.png",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.namastess.keyarinvoices",
      "adaptiveIcon": {
        "foregroundImage": "./assets/keyar-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["INTERNET"]
    },
    "ios": {
      "bundleIdentifier": "com.namastess.keyarinvoices",
      "supportsTablet": true
    },
    "extra": {
      "apiUrl": "https://keyar-invoice-api.onrender.com/api/"
    }
  }
}
